        "--radio",
        "edgetx-tx16s",
        "--start-with",
        "sd",
        "--sd-path",
        "${workspaceFolder}\\simulator"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "RFSuite: Deploy + Start Simulator (TX16S)",
      "dependsOn": [
        "RFSuite: Deploy to Simulator",
        "RFSuite: Start EdgeTX Simulator (TX16S)"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
