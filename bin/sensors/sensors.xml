<Sensors>

    <Group name="Flight Control">
        <Sensor name="ARM" label="Arm"  type="bool" default="0"  multiplier="1" unit="" />
        <Sensor name="Gov" label="Governor" type="select">
            <Option value="0" label="OFF" />
            <Option value="1" label="IDLE" />
            <Option value="2" label="SPOOLUP" />
            <Option value="3" label="RECOVERY" />
            <Option value="4" label="ACTIVE" />
            <Option value="5" label="THROTTLE-OFF" />
            <Option value="6" label="LOST HEADSPEED" />
            <Option value="7" label="AUTOROTATION" />
            <Option value="8" label="BAILOUT" />
            <Option value="100" label="DISABLED" />
            <Option value="101" label="DISARMED" />
        </Sensor>
        <Sensor name="Hspd" label="Headspeed" round="true" type="range" default="1800" min="0" max="2000" rand="10" multiplier="1" unit="rpm" />
    </Group>

    <Group name="Power System">
        <Sensor name="Vbat" label="Main Voltage" type="range" min="0" max="25.2" rand="0" multiplier="100" unit="V" default="24.2" />
        <Sensor name="Vbec" label="BEC Voltage" type="range" rand="5" min="4.0" max="8.0" multiplier="100" unit="V" default="8.0" />
        <Sensor name="Curr" label="Current" type="range" rand="5" min="0" max="200" multiplier="100" unit="A" />
        <Sensor name="Capa" label="Consumption" round="true" type="range" default="0" min="0" max="5000" rand="0" multiplier="1" unit="mAh" />
        <Sensor name="Bat%" label="Fuel" round="true" type="range" default="100" min="0" max="100" rand="0" multiplier="1" unit="%" />
    </Group>

    <Group name="Flight Profiles">
        <Sensor name="PID#" label="PID Profile" type="select">
            <Option value="1" label="1" />
            <Option value="2" label="2" />
            <Option value="3" label="3" />
            <Option value="4" label="4" />
            <Option value="5" label="5" />
            <Option value="6" label="6" />
        </Sensor>
        <Sensor name="RTE#" label="Rate Profile" type="select">
            <Option value="1" label="1" />
            <Option value="2" label="2" />
            <Option value="3" label="3" />
            <Option value="4" label="4" />
            <Option value="5" label="5" />
            <Option value="6" label="6" />
        </Sensor>
        <Sensor name="BatP" label="Battery Profile" type="select" default="1">
            <Option value="1" label="1" />
            <Option value="2" label="2" />
            <Option value="3" label="3" />
            <Option value="4" label="4" />
            <Option value="5" label="5" />
            <Option value="6" label="6" />
        </Sensor>
    </Group>

    <Group name="Temperatures">
        <Sensor name="TescT" label="ESC Temp" round="true" type="range" rand="5" min="10" max="80" default="50" unit="°C" />
        <Sensor name="TmcuT" label="MCU Temp" round="true" type="range" rand="5" min="10" max="80" default="30" unit="°C" />
    </Group>

    <Group name="Other Sensors">
        <Sensor name="Thr%" label="Throttle %" rand="5" round="true" type="range" min="0" max="100" unit="%" default="0" />
        <Sensor name="Alt" label="Altitude" rand="5" round="true" type="range" min="0" max="1000" unit="m" default="0" />   
        <Sensor name="Cel#" label="Cell Count" round="true" type="range" min="1" max="12" unit="" default="6" /> 
    </Group>

    <Group name="Flight Dynamics">
        <Sensor name="Ptch" round="true" rand="20" label="Pitch" type="number" default="0" min="-360" max="360" multiplier="10"/>
        <Sensor name="Roll" round="true" rand="20" label="Roll" type="number" default="0" min="-360" max="360" multiplier="10"/>
        <Sensor name="Yaw" round="true" rand="20" label="Yaw" type="number" default="0" min="-360" max="360" multiplier="10"/>
    </Group>

</Sensors>
